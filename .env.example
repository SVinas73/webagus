# Copiá este archivo como .env y completá los valores.

# Puerto del servidor
PORT=3000
# En producción: NODE_ENV=production (activa cookies Secure)
NODE_ENV=development
# URL pública del sitio (para enlaces en mails y en el panel)
PUBLIC_URL=

# Contraseña del panel /admin (obligatoria para habilitarlo). Usá una larga y única.
ADMIN_PASSWORD=
# Secreto para firmar la sesión (>= 32 caracteres). Si queda vacío se genera uno en data/.session-secret
SESSION_SECRET=

# Carpeta de datos (base SQLite). En hosting con disco persistente, apuntala al volumen.
DATA_DIR=data

# --- Email (opcional). Si falta SMTP_HOST o MAIL_FROM no se envía ningún mail y la web no lo promete. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nombre del Centro <reservas@tu-dominio.com>"
# Dirección del centro que recibe aviso de cada reserva nueva
MAIL_NOTIFY_TO=

# --- Webhook (opcional): POST JSON por cada reserva nueva/cambio (para WhatsApp vía Make/Zapier/n8n) ---
BOOKING_WEBHOOK_URL=
# Si se define, se envía la firma HMAC-SHA256 del cuerpo en el encabezado x-signature
BOOKING_WEBHOOK_SECRET=
